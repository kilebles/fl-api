# Dolphin Anty JWT for the Public API (proxy patching)
ANTY_TOKEN=

# Optional
# ACCOUNTS_ENABLED=["account_1","account_2"]   # default: every account with a dolphin_id
# ANTY_LOCAL_API=http://localhost:3001
# LOG_LEVEL=SUCCESS
# MONITOR_URL=http://192.168.1.100:8080
# ROTATE_EVERY_GENERATIONS=300
# IMAGE_MODEL_NAME=BELUGA
# VIDEO_MODEL_KEY=veo_3_1_t2v_lite_low_priority
# I2V_MODEL_KEY=veo_3_1_r2v_lite_low_priority
# FLASH_T2V_MODEL_KEY=abra_t2v_10s
# FLASH_I2V_MODEL_KEY=abra_r2v_10s
# F2V_MODEL_KEY=abra_t2v_10s

# LLM for prompt generation (Gemini gemini-* models, OpenAI gpt-* models)
GOOGLE_API_KEY=
OPENAI_API_KEY=
# PROMPT_TEMPLATE_MODEL=gemini-2.5-flash
# PROMPT_PARALLEL_RUNS=2
# INFOGRAPHICS_MODEL=gemini-2.5-flash
# RENDER_CONCURRENCY=1                    # Chrome tabs per render; 1 on a small server

# Web API (scripts/serve.py)
# API_TOKEN=change-me
# CORS_ORIGINS=["http://localhost:3000"]
# DATABASE_URL=sqlite+aiosqlite:///data/fl-api.db

# Results: local folder served by the API (default) or an S3 bucket
# STORAGE=local
# STORAGE_DIR=storage
# PUBLIC_URL=http://127.0.0.1:8000
# S3 locally — SeaweedFS from docker-compose.yml:
# STORAGE=s3
# S3_ENDPOINT_URL=http://localhost:8333
# S3_REGION=us-east-1
# S3_ACCESS_KEY=dev
# S3_SECRET_KEY=dev
# Cloudflare R2 in production (STORAGE=s3):
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=<R2 API token access key id>
# S3_SECRET_KEY=<R2 API token secret>

# Translation & voiceover (/api/voice): jobs run in fl-voice_translator — its worker (start_worker.bat) must run on this
# machine. VOICE_DIR is its folder (by default fl-voice_translator / script-translator* in the home folder),
# VOICE_PYTHON its Python (default: its .venv). The Fish key is read from its bot_config.json unless set here.
# VOICE_DIR=C:\Users\Administrator\script-translator
# VOICE_PYTHON=
# FISH_API_KEY=
